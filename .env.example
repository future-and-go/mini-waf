# Copy to .env (scripts/deploy.sh does this automatically and fills secrets).
# .env is git-ignored — never commit real secrets.

# Admin API JWT signing secret. Leave blank → deploy.sh generates a strong one.
JWT_SECRET=

# First-run admin password (username is always "admin"). If blank, the WAF
# generates a random password and prints it once to the container logs.
ADMIN_PASSWORD=admin123

# Response cache backend: memory | embedded | standalone | cluster.
# "standalone" uses the bundled valkey service.
CACHE_BACKEND=standalone

# Log level: error | warn | info | debug | trace.
RUST_LOG=info
