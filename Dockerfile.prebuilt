# Base image is overridable so a binary built on a newer host (glibc) can run on
# a matching runtime. Default stays bookworm-slim — unchanged for existing
# consumers (cluster, e2e, CI). The all-features deploy override passes a
# newer-glibc base via BASE_IMAGE.
ARG BASE_IMAGE=debian:bookworm-slim
FROM ${BASE_IMAGE}

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY target/release/waf /usr/local/bin/waf
COPY configs/   /app/configs/
COPY rules/     /app/rules/
COPY data/      /app/data/
COPY web/admin-panel/dist /app/web/admin-panel/dist
COPY migrations/ /app/migrations/

RUN chmod +x /usr/local/bin/waf

EXPOSE 80 443 9527

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:9527/health || exit 1

CMD ["/usr/local/bin/waf", "--config", "/app/configs/default.toml", "run"]
